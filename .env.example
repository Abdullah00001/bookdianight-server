# ==========================================
# --------- Application Core ---------------
# ==========================================

NODE_ENV="development"

# ==========================================
# --------- Application Database -----------
# ==========================================

# NOTE: For local development, the migrations run on the host machine using port 5440.
# The Docker containers map this port natively inside docker-compose.yaml.
DATABASE_URL="postgresql://postgres:myStrongPassword@localhost:5440/bookdianight?schema=public"

# Redis configuration for containers
REDIS_HOST="redis"
REDIS_PASSWORD="myStrongPassword"
REDIS_PORT="6379"
