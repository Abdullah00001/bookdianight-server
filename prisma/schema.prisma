// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [postgis, fuzzystrmatch, postgis_tiger_geocoder, postgis_topology]
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AccountRole {
  USER
  ADMIN
  CLUB_OWNER
}

enum Platform {
  ANDROID
  IOS
}

enum Service {
  EVENT
  CLUB
}

enum AuthProvider {
  MANUAL
  GOOGLE
  APPLE
}

enum NotificationType {
  NEW_EVENT
  NEW_CLUB
  PAYMENT_SUCCESS
  BOOKING_CONFIRMED
  PAYMENT_RECEIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELED
}

enum LegalContentType {
  ABOUT_US
  TERMS_AND_CONDITION
  PRIVACY_AND_POLICY
}

enum StripeConnectAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
}

enum ClubBookingStatus {
  HOLD
  BOOKED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  PAID
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum SellerTransferStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  SCHEDULED
  PENDING
  SUCCEEDED
  FAILED
}

enum TicketPdfStatus {
  PENDING
  GENERATED
  FAILED
}

enum EventPurchaseAttendeeType {
  BUYER
  FRIEND
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  phoneNumber   String        
  accountStatus AccountStatus @default(ACTIVE)
  accountRole   AccountRole   @default(USER)
  isVerified    Boolean       @default(false)
  password      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Back Relations
  profile      Profile?
  devices      Device[]
  notifications Notification[]
  clubs        Club[]
  clubReviews  ClubReview[]
  events       Event[]
  wishlists    Wishlist[]
  stripeConnectAccount StripeConnectAccount?
  buyerOrders  Order[] @relation("OrderBuyer")
  sellerOrders Order[] @relation("OrderSeller")

  @@index([accountRole])
  @@index([accountStatus])
}

model Profile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location      String?
  dateOfBirth   DateTime?
  gender        Gender?
  profileAvatar String?
  profileCover  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Device {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceIdentifier String       @unique
  fcmToken         String?
  platform         Platform
  authProvider     AuthProvider
  isActive         Boolean      @default(true)
  isLogout         Boolean      @default(false)
  lastSeenAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([isActive, lastSeenAt])
}

model Notification {
  id                     String           @id @default(uuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType       NotificationType
  notificationTitle      String
  notificationDescription String?
  isRead                 Boolean          @default(false)
  metaData               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([userId, isRead])
  @@index([createdAt])
}

model LegalContent {
  id               String           @id @default(uuid())
  legalContentType LegalContentType
  content          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([legalContentType])
}

model ApplicationCharge {
  id                String   @id @default(uuid())
  serviceType       Service  @unique
  chargePercentage  Decimal  @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ServiceCharge {
  id        String   @id @default("GLOBAL")
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  thumbnail   String
  images      String[]
  dressCode   String
  isRecurring Boolean  @default(false)
  lat         Float
  lng         Float
  location    String   @default("")
  geog        Unsupported("geography(Point, 4326)")?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isVip       Boolean  @default(false)
  deactivatedAt DateTime?
  // Back Relations
  reviews          ClubReview[]
  clubOpeningHours ClubOpeningHour[]
  clubPackages     ClubPackage[]
  wishlists        Wishlist[]
  clubBookings     ClubBooking[]

  @@index([userId])
  @@index([lat, lng])
  @@index([geog], type: Gist)
}

model ClubReview {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rating    Float
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clubId]) // one review per user per club
  @@index([clubId])
}

model ClubOpeningHour {
  id             String    @id @default(uuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  dayOfWeek      Int       // 0-6, where 0 is Sunday and 6 is Saturday
  isClosed       Boolean   @default(false)
  openTime       DateTime? @db.Time(0)  // null when isClosed = true
  closeTime      DateTime? @db.Time(0)  // null when isClosed = true
  closesNextDay  Boolean   @default(false) // true when closeTime is past midnight (e.g. open 22:00, close 02:00)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clubId, dayOfWeek]) // one row per club per day
}

model ClubPackage {
  id          String   @id @default(uuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  description String?
  capacity    Int
  price       Decimal  @db.Decimal(10, 2)
  currency    String
  features    String[]
  sortOrder   Int      @default(0) // controls display order within a club, lower shows first
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clubBookings ClubBooking[]

  @@unique([clubId, name])            // no duplicate package names per club
  @@index([clubId, isActive, sortOrder])
}

model Event {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventName        String
  eventDescription String?
  thumbnail        String
  images           String[]
  eventStatus      EventStatus @default(UPCOMING)
  lat              Float
  lng              Float
  location         String      @default("")
  geog             Unsupported("geography(Point, 4326)")?
  startAt          DateTime
  endAt            DateTime
  dressCode        String
  eventPrice       Decimal     @db.Decimal(10, 2)
  currency         String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deactivatedAt    DateTime?

  // Back Relations
  wishlists      Wishlist[]
  eventPurchases EventPurchase[]

  @@index([userId])
  @@index([eventStatus, startAt])
  @@index([lat, lng])
  @@index([geog], type: Gist)
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@unique([userId, clubId])
  @@index([userId])
  @@index([eventId])
  @@index([clubId])
}

model StripeConnectAccount {
  id                   String                     @id @default(uuid())
  userId               String                     @unique
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  stripeAccountId      String                     @unique
  status               StripeConnectAccountStatus @default(PENDING)
  onboardingCompletedAt DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([status])
}

model Order {
  id                  String      @id @default(uuid())
  buyerUserId         String
  buyer               User        @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerUserId        String
  seller              User        @relation("OrderSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  serviceType         Service
  status              OrderStatus @default(PENDING_PAYMENT)
  buyerName           String
  buyerPhoneNumber    String
  buyerDateOfBirth    DateTime?
  buyerGender         Gender?
  buyerImage          String?
  grossAmount         Decimal     @db.Decimal(10, 2)
  serviceChargeAmount Decimal     @db.Decimal(10, 2)
  buyerTotal          Decimal     @db.Decimal(10, 2)
  commissionRate      Decimal     @db.Decimal(5, 2)
  commissionAmount    Decimal     @db.Decimal(10, 2)
  sellerEarnings      Decimal     @db.Decimal(10, 2)
  currency            String
  idempotencyKey      String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  clubBooking        ClubBooking?
  eventPurchase      EventPurchase?
  paymentTransaction PaymentTransaction?
  sellerTransfer     SellerTransfer?
  refund             Refund?
  ticketPdf          TicketPdf?

  @@index([buyerUserId, createdAt])
  @@index([sellerUserId, createdAt])
  @@index([serviceType, status, createdAt])
  @@unique([buyerUserId, idempotencyKey])
}

model ClubBooking {
  id              String            @id @default(uuid())
  orderId         String            @unique
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  clubId          String
  club            Club              @relation(fields: [clubId], references: [id], onDelete: Restrict)
  clubPackageId   String
  clubPackage     ClubPackage       @relation(fields: [clubPackageId], references: [id], onDelete: Restrict)
  status          ClubBookingStatus @default(HOLD)
  startAt         DateTime
  endAt           DateTime
  holdExpiresAt   DateTime
  guestCount      Int
  clubName        String
  clubLocation    String
  packageName     String
  packageCapacity Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clubPackageId, status, startAt, endAt])
  @@index([status, holdExpiresAt])
  @@index([clubId, startAt])
}

model EventPurchase {
  id                 String              @id @default(uuid())
  orderId            String              @unique
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eventId            String
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  personCount        Int
  eventName          String
  eventLocation      String
  eventStartAt       DateTime
  eventEndAt         DateTime
  pricePerPerson     Decimal             @db.Decimal(10, 2)
  transferEligibleAt DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attendees EventPurchaseAttendee[]

  @@index([eventId, createdAt])
  @@index([transferEligibleAt])
}

model EventPurchaseAttendee {
  id              String                    @id @default(uuid())
  eventPurchaseId String
  eventPurchase   EventPurchase             @relation(fields: [eventPurchaseId], references: [id], onDelete: Restrict)
  attendeeType    EventPurchaseAttendeeType
  position        Int
  name            String
  phoneNumber     String
  gender          Gender?
  age             Int?
  image           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([eventPurchaseId, position])
  @@index([eventPurchaseId, attendeeType])
}

model PaymentTransaction {
  id                    String                   @id @default(uuid())
  orderId               String                   @unique
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stripePaymentIntentId String?                  @unique
  stripeChargeId        String?                  @unique
  idempotencyKey        String                   @unique
  status                PaymentTransactionStatus @default(PENDING)
  amount                Decimal                  @db.Decimal(10, 2)
  currency              String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, createdAt])
}

model WebhookEvent {
  id            String             @id @default(uuid())
  stripeEventId String             @unique
  eventType     String
  status        WebhookEventStatus @default(RECEIVED)
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, createdAt])
}

model SellerTransfer {
  id               String               @id @default(uuid())
  orderId          String               @unique
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stripeTransferId String?              @unique
  idempotencyKey   String               @unique
  status           SellerTransferStatus @default(PENDING)
  amount           Decimal              @db.Decimal(10, 2)
  currency         String
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
}

model Refund {
  id             String       @id @default(uuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stripeRefundId String?      @unique
  idempotencyKey String       @unique
  status         RefundStatus @default(SCHEDULED)
  amount         Decimal      @db.Decimal(10, 2)
  currency       String
  scheduledFor   DateTime
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, scheduledFor])
}

model TicketPdf {
  id         String          @id @default(uuid())
  orderId    String          @unique
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status     TicketPdfStatus @default(PENDING)
  storageKey String?
  generatedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, createdAt])
}
