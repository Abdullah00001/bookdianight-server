// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [postgis, fuzzystrmatch, postgis_tiger_geocoder, postgis_topology]
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AccountRole {
  USER
  ADMIN
  CLUB_OWNER
}

enum Platform {
  ANDROID
  IOS
}

enum Service {
  EVENT
  CLUB
}

enum AuthProvider {
  MANUAL
  GOOGLE
  APPLE
}

enum NotificationType {
  NEW_EVENT
  NEW_CLUB
  PAYMENT_SUCCESS
  BOOKING_CONFIRMED
  PAYMENT_RECEIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELED
}

enum LegalContentType {
  ABOUT_US
  TERMS_AND_CONDITION
  PRIVACY_AND_POLICY
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  phoneNumber   String        
  accountStatus AccountStatus @default(ACTIVE)
  accountRole   AccountRole   @default(USER)
  isVerified    Boolean       @default(false)
  password      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Back Relations
  profile      Profile?
  devices      Device[]
  notifications Notification[]
  clubs        Club[]
  clubReviews  ClubReview[]
  events       Event[]
  wishlists    Wishlist[]

  @@index([accountRole])
  @@index([accountStatus])
}

model Profile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location      String?
  dateOfBirth   DateTime?
  gender        Gender?
  profileAvatar String?
  profileCover  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Device {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken     String?      @unique
  platform     Platform
  authProvider AuthProvider
  isActive     Boolean      @default(true)
  isLogout     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
}

model Notification {
  id                     String           @id @default(uuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType       NotificationType
  notificationTitle      String
  notificationDescription String?
  isRead                 Boolean          @default(false)
  metaData               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([userId, isRead])
  @@index([createdAt])
}

model LegalContent {
  id               String           @id @default(uuid())
  legalContentType LegalContentType
  content          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([legalContentType])
}

model ApplicationCharge {
  id                String   @id @default(uuid())
  serviceType       Service
  chargePercentage  Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([serviceType])
}

model Club {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  thumbnail   String
  images      String[]
  dressCode   String
  isRecurring Boolean  @default(false)
  lat         Float
  lng         Float
  geog        Unsupported("geography(Point, 4326)")?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Back Relations
  reviews          ClubReview[]
  clubOpeningHours ClubOpeningHour[]
  clubPackages     ClubPackage[]
  wishlists        Wishlist[]

  @@index([userId])
  @@index([lat, lng])
  @@index([geog], type: Gist)
}

model ClubReview {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rating    Float
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clubId]) // one review per user per club
  @@index([clubId])
}

model ClubOpeningHour {
  id             String    @id @default(uuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  dayOfWeek      Int       // 0-6, where 0 is Sunday and 6 is Saturday
  isClosed       Boolean   @default(false)
  openTime       DateTime? @db.Time(0)  // null when isClosed = true
  closeTime      DateTime? @db.Time(0)  // null when isClosed = true
  closesNextDay  Boolean   @default(false) // true when closeTime is past midnight (e.g. open 22:00, close 02:00)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clubId, dayOfWeek]) // one row per club per day
}

model ClubPackage {
  id          String   @id @default(uuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  description String?
  capacity    Int
  price       Decimal  @db.Decimal(10, 2)
  currency    String
  features    String[]
  sortOrder   Int      @default(0) // controls display order within a club, lower shows first
  isVip       Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clubId, name])            // no duplicate package names per club
  @@index([clubId, isActive, sortOrder])
}

model Event {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventName        String
  eventDescription String?
  thumbnail        String
  images           String[]
  eventStatus      EventStatus @default(UPCOMING)
  lat              Float
  lng              Float
  geog             Unsupported("geography(Point, 4326)")?
  startAt          DateTime
  endAt            DateTime
  dressCode        String
  eventPrice       Decimal     @db.Decimal(10, 2)
  currency         String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Back Relations
  wishlists Wishlist[]

  @@index([userId])
  @@index([eventStatus, startAt])
  @@index([lat, lng])
  @@index([geog], type: Gist)
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@unique([userId, clubId])
  @@index([userId])
  @@index([eventId])
  @@index([clubId])
}