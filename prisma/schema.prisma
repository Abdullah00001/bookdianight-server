generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator cornClient {
  provider = "prisma-client-js"
  output   = "../scheduler/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
